# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API (for Whisper voice transcription and GPT-4 Vision)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API (for Claude Vision - alternative to GPT-4 Vision)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Splitwise API
SPLITWISE_CONSUMER_KEY=your_splitwise_consumer_key_here
SPLITWISE_CONSUMER_SECRET=your_splitwise_consumer_secret_here

# Tricount API (if available)
TRICOUNT_API_KEY=your_tricount_api_key_here

# Database
DATABASE_URL=sqlite:///cheqmate.db

# Application Settings
DEBUG=True
LOG_LEVEL=INFO
